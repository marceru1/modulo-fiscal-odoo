<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="meu_modulo.ClosePosPopupFechamento" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">

        <!-- Botão "Fechamento" (imprimir relatório custom) após o nativo "Daily Sale".
             Desabilitado até o operador confirmar o valor do dinheiro (DEC-001/DEC-003). -->
        <xpath expr="//button[@t-on-click='downloadSalesReport']" position="after">
            <button class="button btn btn-secondary"
                t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg ms-auto'"
                t-att-disabled="!state.valor_confirmado"
                t-on-click="showFechamento"
                title="Imprimir relatório de fechamento de caixa">
                Fechamento
                <i t-if="!this.ui.isSmall" class="fa fa-print" role="img"/>
            </button>
        </xpath>

        <!--
            lock-dinheiro-pos-impressao: confirmar o valor do dinheiro antes de
            imprimir/fechar (DEC-001/DEC-003).

            Âncora: o botão t-on-click="autoFillCashCount" é único no template
            nativo e está dentro da div que envolve o Input do dinheiro.
            Usamos o pai desse botão (a div d-flex w-100) como alvo.
        -->

        <!-- Trava visual no wrapper do Input de dinheiro (pai do botão autoFillCashCount) -->
        <xpath expr="//button[@t-on-click='autoFillCashCount']/.." position="attributes">
            <attribute name="t-att-class">{'pe-none opacity-50': state.valor_confirmado}</attribute>
        </xpath>

        <!-- Botão "Confirmar Valor" após o wrapper do Input -->
        <xpath expr="//button[@t-on-click='autoFillCashCount']/.." position="after">
            <button class="btn btn-secondary w-100 mt-1"
                t-on-click="confirmValorDinheiro"
                t-if="!state.valor_confirmado">
                Confirmar Valor
            </button>
        </xpath>

        <!-- Botão nativo "Close Register": desabilitado até confirmar o valor.
             Mantém o canConfirm() nativo (todos os counted válidos). -->
        <xpath expr="//button[@t-on-click='confirm']" position="attributes">
            <attribute name="t-att-disabled">!state.valor_confirmado || !canConfirm()</attribute>
        </xpath>

    </t>

</templates>