<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Legenda dos atalhos: chips "tecla + ação" (ticket 05).

        div passiva e decorativa: sem t-on-click, sem tabindex, aria-hidden.
        O aria-hidden esconde a faixa de leitores de tela de propósito — ela
        duplica, em texto, teclas que já funcionam; não é conteúdo.
    -->
    <t t-name="meu_modulo.AtalhosLegend">
        <div class="atalhos-legend" aria-hidden="true">
            <span class="atalhos-legend-chip" t-foreach="chips" t-as="chip" t-key="chip.tecla">
                <kbd class="atalhos-legend-kbd" t-esc="chip.tecla.toUpperCase()" />
                <span class="atalhos-legend-acao" t-esc="chip.acao" />
            </span>
        </div>
    </t>

    <!--
        Onde a legenda entra (protótipo validado pelo orquestrador, ticket 05).

        ProductScreen — no leftpane, logo ACIMA da barra Pagar e abaixo do
        carrinho: OrderSummary (carrinho) → legenda → div.pads (que contém o
        ActionpadWidget "Pagar"). O ticket citava a .switchpane, mas essa div só
        existe no branch mobile do core; o leftpane vale para os dois branches,
        então a âncora no OrderSummary cobre mobile e desktop. Validado com o
        usuário (ver DEC-010).

        PaymentScreen — acima do rodapé de ações (Back/Validate), mesmo
        princípio: legenda entre o Numpad e a div do rodapé.

        ARMADILHA (checada antes do commit): `hasclass()` do core NÃO vê
        `t-attf-class`. O template_inheritance.js (linha 60) compila
        hasclass('x') para `contains(concat(' ', @class, ' '), ' x ')`, que lê o
        atributo @class literal. A div do rodapé da PaymentScreen e a .switchpane
        usam `t-attf-class`, então ancorá-las com hasclass casaria 0 nós e o
        Odoo aborta a herança do template inteiro ("cannot be located") —
        derrubando o bundle do POS. Por isso a âncora é o <Numpad>, que tem
        @class real.

        position="after"/"before" apenas: nada de "replace", que quebraria o DOM
        para outros módulos que herdam estas telas.
    -->
    <t t-name="meu_modulo.AtalhosLegendProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('leftpane')]/OrderSummary" position="after">
            <AtalhosLegend tela="'ProductScreen'" />
        </xpath>
    </t>

    <t t-name="meu_modulo.AtalhosLegendPaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('left-content')]/Numpad" position="after">
            <AtalhosLegend tela="'PaymentScreen'" />
        </xpath>
    </t>

    <!--
        TicketScreen — no painel direito (leftpane do core), ANTES da
        div.control-buttons (Details/Print Receipt): legenda R + globais.
        Âncora única ARMADILHA-CHECADA: div[hasclass('pads')] casa 2 nós no
        template do core (branch t-if isOrderSynced E branch t-else) — XPath
        ambíguo aborta a herança e derruba o bundle. control-buttons existe
        1x (dentro da pads do branch desktop). Sem t-attf-class na âncora.
    -->
    <t t-name="meu_modulo.AtalhosLegendTicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="before">
            <AtalhosLegend tela="'TicketScreen'" />
        </xpath>
    </t>

</templates>
