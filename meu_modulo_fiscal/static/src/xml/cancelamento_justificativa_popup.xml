<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Popup de justificativa do cancelamento de cupom (evento 110111).

        O Confirmar só habilita com >= MIN_JUSTIFICATIVA caracteres (15) —
        barreira que evita mandar pra SEFAZ uma justificativa que a Focus
        rejeitaria de qualquer forma.

        Sem misturar `class` literal com `t-att-class` no mesmo nó: o
        t-att-class do Owl concatena com o class estático de um jeito que já
        mordeu neste módulo (ver o teste E4 de test_confirm_sale_popup.js).
        Cada estado tem seu próprio div com a classe completa.

        Nada de entidades HTML nomeadas (as de acento, traço, bullet...): o
        lxml do Odoo é estrito e uma entidade não declarada derruba o bundle
        do POS inteiro. Usar o caractere unicode direto no texto.
    -->
    <t t-name="meu_modulo_fiscal.CancelamentoJustificativaPopup">
        <Dialog title="props.title">
            <textarea
                rows="4"
                class="form-control form-control-lg mx-auto"
                placeholder="Motivo do cancelamento (mínimo 15 caracteres)"
                t-model="state.inputValue"
                t-ref="input"
            />
            <div t-if="valido" class="mt-2 text-center text-success">
                Justificativa registrada — segue no evento de cancelamento da SEFAZ.
            </div>
            <div t-else="" class="mt-2 text-center text-muted">
                Faltam <t t-esc="faltam"/> caractere(s) para liberar o cancelamento.
            </div>
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary btn-lg lh-lg o-default-button"
                    t-on-click="confirmar"
                    t-att-disabled="confirmDisabled"
                >Confirmar cancelamento</button>
                <button
                    class="btn btn-secondary btn-lg lh-lg o-default-button"
                    t-on-click="cancelar"
                >Voltar</button>
            </t>
        </Dialog>
    </t>

</templates>
