<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Chips de tipo de pagamento na lista de pedidos pagos do POS (tab "Pago").
         Mesmo padrão de herança dos outros XML do módulo (pos_navbar_logo.xml).

         ANCORAGEM (desvio consciente do ticket 03, que pedia position="after"
         no <SearchBar>): o <SearchBar> vive DENTRO de <div class="controls">,
         que é grid nomeado no mobile (ticket_screen.scss:58-63,
         grid-template-areas "buttons pagination" / "search search") e flex SEM
         wrap no desktop (d-sm-flex). Inserir os chips ali os colocaria na MESMA
         linha dos controles no desktop — contra o DEC-007, que pede os chips
         numa linha ABAIXO da SearchBar. Ancorando depois de .controls os chips
         viram irmãos dentro de .rightpane (d-flex flex-column) e ganham linha
         própria em todos os breakpoints, sem CSS extra. Os xpaths //SearchBar e
         //div[hasclass('controls')] são ambos únicos neste template. -->
    <t t-name="meu_modulo.FiltroPedidosPagosChips"
       t-inherit="point_of_sale.TicketScreen"
       t-inherit-mode="extension">

        <!-- Tab "Pago": paginação do core oculta (contador "1/10" e ◀ ▶).
             Nunca replace: o nó continua no DOM (position="attributes"), só
             ganha a classe de ocultação. t-attf-class repete a string estática
             para valer nos dois motores: no QWeb o atributo dinâmico
             SUBSTITUI o class do nó (ir_qweb.py, addAttributes()); no Owl as
             classes se somam. Os demais tabs mantêm contador e botões. -->
        <xpath expr="//div[hasclass('controls')]/div[hasclass('item')]" position="attributes">
            <attribute name="t-attf-class">item d-flex align-items-center justify-content-end #{state.filter === 'SYNCED' ? 'd-none' : ''}</attribute>
        </xpath>

        <!-- Scroll infinito (DEC-005): o mesmo container rolável do core passa
             a avisar quando o fim está próximo. O handler só age no SYNCED. -->
        <xpath expr="//div[hasclass('orders')]" position="attributes">
            <attribute name="t-on-scroll">onPagoScroll</attribute>
        </xpath>
        <xpath expr="//div[hasclass('controls')]" position="after">
            <t t-if="state.filter === 'SYNCED'">
                <!-- Classes numa única t-attf-class: no QWeb, class estático +
                     t-att-class não somam — o dinâmico sobrescreve o estático
                     (ir_qweb.py, addAttributes()).
                     No mobile a linha vira scroll horizontal (flex-nowrap +
                     overflow-x) para não empilhar muitos métodos. -->
                <div t-attf-class="payment-filter-chips d-flex gap-2 px-2 pb-2 #{ui.isSmall ? 'flex-nowrap overflow-x-auto' : 'flex-wrap'}">
                    <!-- Toggle de ordenação (DEC-006/DEC-007), na MESMA fila
                         dos chips: nenhum ponto de ancoragem novo. Sem atalho
                         de teclado (no PDV, teclas são A–E, nunca dígitos). -->
                    <div class="btn-group btn-group-sm" role="group" aria-label="Ordenação por data">
                        <button t-attf-class="btn text-nowrap #{state.pagoOrdenacaoAsc ? 'btn-outline-secondary' : 'btn-primary'}"
                                t-attf-aria-pressed="#{state.pagoOrdenacaoAsc ? 'false' : 'true'}"
                                t-on-click="() =&gt; this.setPagoOrdenacao(false)">Mais próximas</button>
                        <button t-attf-class="btn text-nowrap #{state.pagoOrdenacaoAsc ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-attf-aria-pressed="#{state.pagoOrdenacaoAsc ? 'true' : 'false'}"
                                t-on-click="() =&gt; this.setPagoOrdenacao(true)">Mais antigas</button>
                    </div>
                    <t t-foreach="getAvailablePaymentMethods()" t-as="method" t-key="method.id">
                        <button t-attf-class="btn btn-sm text-nowrap #{state.activePaymentMethodIds.has(method.id) ? 'btn-primary' : 'btn-outline-secondary'}"
                                t-on-click="() =&gt; this.onTogglePaymentChip(method.id)">
                            <t t-esc="method.name"/>
                        </button>
                    </t>
                </div>
            </t>
        </xpath>
    </t>

</templates>
