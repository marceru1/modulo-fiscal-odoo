<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="meu_modulo.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        
        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('paymentlines')]" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('before-footer')]" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('after-footer')]" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-order-data')]" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath expr="//ReceiptHeader" position="replace">
            
            <div class="danfe-header" style="text-align: center; font-family: 'Inconsolata', monospace; font-size: 12px;">
                <div class="emitente-nome" style="font-size: 14px; margin-bottom: 2px;">
                    <t t-esc="props.data.empresa.nome ? props.data.empresa.nome.toUpperCase() : ''"/>
                </div>
                
                <div class="emitente-dados" style="display: flex; justify-content: center; gap: 15px;">
                    <span>CNPJ: <t t-esc="props.data.empresa.cnpj"/></span>
                    <span>IE: <t t-esc="props.data.empresa.ie"/></span>
                </div>
                
                <div class="emitente-endereco">
                    <t t-esc="props.data.empresa.endereco_linha1 ? props.data.empresa.endereco_linha1.toUpperCase() : ''"/><br/>
                    <t t-esc="props.data.empresa.endereco_linha2 ? props.data.empresa.endereco_linha2.toUpperCase() : ''"/><t t-if="props.data.empresa.telefone">, <t t-esc="props.data.empresa.telefone"/></t>
                </div>

                <div class="danfe-separador" style="border-bottom: 1px dashed #000; margin: 4px 0;"></div>

                <t t-if="props.data.x_fiscal and (props.data.x_fiscal.status === 'autorizado' or props.data.x_fiscal.status === 'contingencia')">
                    <div class="danfe-tipo" style="font-size: 12px; margin: 2px 0;">
                        DOCUMENTO AUXILIAR DA NOTA FISCAL DE CONSUMIDOR<br/>
                        ELETRÔNICA
                    </div>
                    <div class="danfe-separador" style="border-bottom: 1px dashed #000; margin: 4px 0;"></div>
                </t>

            </div>

        </xpath>

        <xpath expr="//OrderWidget" position="replace">
             <div class="danfe-items" style="font-family: 'Inconsolata', monospace; font-size: 11px;">
                <div class="receipt-header-row1">
                    <span class="col-left">CÓDIGO</span>
                    <span class="col-left">DESCRIÇÃO</span>
                </div>
                <div class="receipt-header-row2">
                    <span></span>
                    <span class="col-center">QTD</span>
                    <span class="col-center">UN</span>
                    <span class="col-right">VL UN</span>
                    <span class="col-right">DESC</span>
                    <span class="col-right">VL TOT</span>
                </div>
                <div class="danfe-separador" style="border-bottom: 1px dashed #000; margin: 4px 0;"></div>

                <t t-foreach="props.data.danfe_items" t-as="item" t-key="item.index">
                    <div style="margin-bottom: 4px;">
                        <div class="item-linha1">
                            <span class="col-left"><t t-esc="item.code"/></span>
                            <span class="col-left"><t t-esc="item.description"/></span>
                        </div>
                        <div class="item-linha2">
                            <span></span>
                            <span class="col-center"><t t-esc="item.qntd"/></span>
                            <span class="col-center">
                                <t t-if="item.unit.includes('Unidad')">UN</t>
                                <t t-else=""><t t-esc="item.unit.substring(0, 3).toUpperCase()"/></t>
                            </span>
                            <span class="col-right"><t t-esc="props.formatCurrency(item.vlr_unit).replace('R$', '').trim()"/></span>
                            <span class="col-right"><t t-esc="props.formatCurrency(item.desc || 0).replace('R$', '').trim()"/></span>
                            <span class="col-right"><t t-esc="props.formatCurrency(item.vlr_total).replace('R$', '').trim()"/></span>
                        </div>
                    </div>
                </t>
            </div>
            <div class="danfe-separador" style="border-bottom: 1px dashed #000; margin: 4px 0;"></div>
        </xpath>


        <xpath expr="//div[hasclass('pos-receipt-taxes')]" position="replace">
            
            <div class="totais-section" style="font-family: 'Inconsolata', monospace; font-size: 12px;">
                <div class="total-linha" style="display: flex; justify-content: space-between;">
                    <span class="total-label">QTD. TOTAL DE ITENS</span>
                    <span class="total-valor"><t t-esc="props.data.danfe_totais.qtd_itens"/></span>
                </div>
                <div class="total-linha" style="display: flex; justify-content: space-between;">
                    <span class="total-label">VALOR TOTAL R$</span>
                    <span class="total-valor"><t t-esc="props.formatCurrency(props.data.danfe_totais.valor_total).replace('R$', '').trim()"/></span>
                </div>
                <t t-if="props.data.x_amount_other_value and props.data.x_amount_other_value > 0 or props.data.danfe_totais.desconto_total and props.data.danfe_totais.desconto_total > 0">
                    <t t-if="props.data.x_amount_other_value and props.data.x_amount_other_value > 0">
                        <div class="total-linha" style="display: flex; justify-content: space-between;">
                            <span class="total-label">ACRÉSCIMO</span>
                            <span class="total-valor"><t t-esc="props.formatCurrency(props.data.x_amount_other_value || 0).replace('R$', '').trim()"/></span>
                        </div>
                    </t>
                    <t t-if="props.data.danfe_totais.desconto_total and props.data.danfe_totais.desconto_total > 0">
                        <div class="total-linha" style="display: flex; justify-content: space-between;">
                            <span class="total-label">DESCONTO</span>
                            <span class="total-valor"><t t-esc="props.formatCurrency(props.data.danfe_totais.desconto_total).replace('R$', '').trim()"/></span>
                        </div>
                    </t>
                </t>
                <div class="total-linha" style="display: flex; justify-content: space-between;">
                    <span class="total-label">VALOR A PAGAR R$</span>
                    <t t-set="valor_a_pagar" t-value="(props.data.danfe_totais.valor_total || 0) + (props.data.x_amount_other_value || 0) - (props.data.danfe_totais.desconto_total || 0)"/>
                    <span class="total-valor"><t t-esc="props.formatCurrency(valor_a_pagar).replace('R$', '').trim()"/></span>
                </div>

                <t t-foreach="props.data.danfe_totais.metodos" t-as="pgto" t-key="pgto.metodo_nome">
                    <div class="pagamento-linha" style="display: flex; justify-content: space-between;">
                        <span class="pagamento-metodo"><t t-esc="pgto.metodo_nome ? pgto.metodo_nome.toUpperCase() : ''"/></span>
                        <span class="pagamento-valor"><t t-esc="props.formatCurrency(pgto.metodo_valor).replace('R$', '').trim()"/></span>
                    </div>
                </t>
                <!-- Troco -->
                <t t-set="troco" t-value="props.data.danfe_totais.metodos.reduce((acc, p) => acc + p.metodo_valor, 0) - valor_a_pagar"/>
                <t t-if="troco > 0.009">
                    <div class="pagamento-linha" style="display: flex; justify-content: space-between;">
                        <span class="pagamento-metodo">TROCO</span>
                        <span class="pagamento-valor"><t t-esc="props.formatCurrency(troco).replace('R$', '').trim()"/></span>
                    </div>
                </t>

                <div class="danfe-separador" style="border-bottom: 1px dashed #000; margin: 4px 0;"></div>

            </div>

            <div class="fiscal-section" style="text-align: center; font-family: 'Inconsolata', monospace; font-size: 12px;">

                <t t-if="props.data.x_fiscal and (props.data.x_fiscal.status === 'autorizado' or props.data.x_fiscal.status === 'contingencia')">
                    
                    <t t-if="props.data.x_fiscal.offline">
                        <div style="margin-bottom: 2px;">
                            EMITIDA EM CONTINGÊNCIA
                        </div>
                    </t>

                    <div class="fiscal-numero">
                        Número: <t t-esc="props.data.x_fiscal.numero"/> 
                        Série: <t t-esc="props.data.x_fiscal.serie"/> 
                        Emissão: <t t-esc="props.data.date"/> 
                    </div>
                    
                    <div style="margin: 2px 0;">Via Consumidor</div>
                    
                    <div style="margin: 2px 0;">Consulte pela Chave de Acesso em</div>
                    <div style="margin: 2px 0;">http://www.nfce.sefaz.am.gov.br/consumidor/</div>

                    <div style="margin: 4px 0;">CHAVE DE ACESSO</div>
                    <div style="margin: 2px 0; letter-spacing: 0.5px; word-break: break-all; line-height: 1.2;">
                        <t t-if="props.data.x_fiscal.chave_formatada">
                            <t t-esc="props.data.x_fiscal.chave_formatada"/>
                        </t>
                        <t t-else="">
                            <t t-esc="props.data.x_fiscal.chave"/>
                        </t>
                    </div>

                    <div style="margin-bottom: 4px;">
                        <t t-if="props.data.x_cpf_nota">
                            CONSUMIDOR CPF: <t t-esc="props.data.x_cpf_nota"/>
                        </t>
                        <t t-else="">
                            CONSUMIDOR NÃO IDENTIFICADO
                        </t>
                    </div>

                    <div class="fiscal-qrcode" style="margin: 4px 0; display: flex; justify-content: center;">
                        <t t-if="props.data.x_fiscal.qrcode_b64">
                             <img t-att-src="'data:image/png;base64,' + props.data.x_fiscal.qrcode_b64" 
                                  style="width: 140px; height: 140px; display: block;"/>
                        </t>
                        <t t-elif="props.data.x_fiscal.qrcode_url">
                             <img t-att-src="props.data.x_fiscal.qrcode_url" 
                                  style="width: 140px; height: 140px; display: block;"/>
                        </t>
                    </div>

                    <div class="danfe-separador" style="border-bottom: 1px dashed #000; margin: 4px 0;"></div>

                    <div style="display: flex; justify-content: space-between; font-size: 11px;">
                        <span>Tributos Totais e Incidentes (Lei Federal 12.741/2012)</span>
                        <span>(0,14%)</span>
                    </div>

                </t>
                
                <t t-else="">
                    <div style="text-align: left; margin-left: 5px; margin-top: 10px;">
                        <div>Data: <t t-esc="props.data.date"/></div>
                        <div>Op.: <t t-esc="props.data.cashier"/></div>
                        <t t-if="props.data.x_cpf_nota">
                            <div style="margin-top: 4px;">CPF: <t t-esc="props.data.x_cpf_nota"/></div>
                        </t>
                    </div>
                      
                      <div class="danfe-separador" style="border-bottom: 1px dashed #000; margin: 4px 0;"></div>

                    <div style="margin-top: 15px; margin-bottom: 15px; font-style: italic; text-align: center;">
                        Agradecemos a preferência!
                    </div>
                </t>

                <div class="danfe-separador" style="border-bottom: 1px dashed #000; margin: 4px 0;"></div>

                <div style="text-align: center; font-size: 11px;">
                    Desenvolvido por Divisão de Tecnologia <strong>Grupo 20+</strong>
                </div>

                <div class="danfe-separador" style="border-bottom: 1px dashed #000; margin: 4px 0;"></div>

                <div style="display: flex; justify-content: space-between; font-size: 11px; margin-top: 4px;">
                    <span>Op.: <t t-esc="props.data.cashier"/></span>
                    <span>Vend.: <t t-esc="props.data.cashier"/></span>
                </div>
            </div>

        </xpath>

    </t>

</templates>