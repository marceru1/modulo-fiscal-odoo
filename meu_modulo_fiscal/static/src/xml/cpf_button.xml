<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]" position="replace">
            <button class="button btn btn-light btn-lg d-flex justify-content-between align-items-baseline w-100 w-md-50 lh-lg"
                t-on-click="clickCpfButton">
                <span><i class="fa fa-id-card me-2" />CPF / Nota</span>
            </button>
        </xpath>
    </t>

</templates>