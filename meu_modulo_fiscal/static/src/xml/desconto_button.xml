<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[@name='acrescimo_desconto_row']" position="inside">
            <button class="button btn btn-light btn-lg d-flex justify-content-between align-items-baseline flex-fill lh-lg"
                t-on-click="clickDescontoButton">
                <span><i class="fa fa-minus-circle me-2" />Desconto</span>
                <t t-if="currentOrder.x_discount_value">
                    <span><t t-esc="env.utils.formatCurrency(currentOrder.x_discount_value)"/></span>
                </t>
            </button>
        </xpath>
    </t>

</templates>
