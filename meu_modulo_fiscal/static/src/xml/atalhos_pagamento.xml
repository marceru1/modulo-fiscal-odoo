<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Badge com a letra do atalho no canto do botão de cada método de
        pagamento (DEC-004: descoberta sem treinamento).

        position="inside" no div do método: o node já existe (iterado por
        payment_methods_from_config) e só ganha um filho. Nada de
        position="replace", que quebraria o DOM para outros módulos.

        paymentMethod_index vem do t-foreach do template do core, então o badge
        segue a ordem de render — a mesma que letraDoMetodo() usa nos atalhos.
        letraAtalhoMetodo() devolve "" para método sem atalho e o t-if esconde.

        O "//" depois de .paymentmethods não é estilo: entre o container e o
        botão existe um <t t-foreach>, então o caminho direto
        (div/div) casaria ZERO nós e o badge simplesmente não apareceria.
        Verificado com xmllint sobre o template do core (1 nó).
    -->
    <t t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethods')]//div[hasclass('paymentmethod')]" position="inside">
            <t t-if="letraAtalhoMetodo(paymentMethod_index)">
                <span class="payment-method-hotkey" t-esc="letraAtalhoMetodo(paymentMethod_index)" />
            </t>
        </xpath>
    </t>

</templates>
