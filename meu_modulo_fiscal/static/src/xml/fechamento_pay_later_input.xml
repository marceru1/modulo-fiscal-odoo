<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Extende o popup de fechamento de caixa (ClosePosPopup) para adicionar
        um bloco de input "Counted" para métodos de pagamento do tipo
        `pay_later` (A Prazo / conta do cliente), igual ao bloco que já existe
        para métodos `bank`.

        O bloco é renderizado só para pay_later (t-if="pm.type === 'pay_later'").
        O state.payments[pm.id] é pré-preenchido pelo patch JS
        (fechamento_pay_later_input.js) em getInitialState(), então o input
        já vem com o valor do sistema e o operador pode ajustar.

        O getDifference(pm.id) do core funciona para qualquer método em
        non_cash_payment_methods, então a diferença é calculada automaticamente
        e aparece no overview do popup.

        Inserimos o novo bloco logo antes do container de notas
        (.notes-container), que fica após os inputs de bank no template original.
    -->
    <t t-name="meu_modulo.ClosePosPopupPayLaterInput" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('notes-container')]" position="before">
            <div class="w-100 mb-3" t-foreach="props.non_cash_payment_methods" t-as="pm" t-key="pm.id">
                <t t-if="pm.type === 'pay_later' and pm.number !== 0">
                    <span><t t-esc="pm.name" /> Count</span>
                    <Input tModel="[state.payments[pm.id], 'counted']"
                        isValid.bind="env.utils.isValidFloat" />
                </t>
            </div>
        </xpath>

        <!-- Remove o botão de abrir modal de contagem de notas (fa-money) -->
        <xpath expr="//div[hasclass('d-flex','w-100','gap-2','mt-1')]/button[contains(@class, 'fa-money')]" position="replace">
        </xpath>

        <!-- Remove o botão de auto-preencher valor vendido (fa-clone) -->
        <xpath expr="//div[hasclass('d-flex','w-100','gap-2','mt-1')]/button[contains(@class, 'fa-clone')]" position="replace">
        </xpath>
    </t>

</templates>