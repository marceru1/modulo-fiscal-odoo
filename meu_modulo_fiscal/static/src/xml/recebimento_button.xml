<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="meu_modulo.NavbarRecebimento" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[@onSelected='() =&gt; this.pos.cashMove()']" position="after">
            <DropdownItem t-if="showCashMoveButton" onSelected="() => this.showRecebimento()">
                Recebimento
            </DropdownItem>
        </xpath>
    </t>
</templates>
