[options]
; ==============================================================================
; Odoo 18.0 — Configuração de Produção (usada dentro do container Docker)
; ==============================================================================
; Segredos de banco de dados são passados via variáveis de ambiente:
;   HOST, PORT, USER, PASSWORD → lidos pelo entrypoint oficial do Odoo
; ==============================================================================

; O banco de dados a ser usado é definido pela variável de ambiente DB_NAME
; configurada no Dokploy (ex: DB_NAME=grupo20mais ou DB_NAME=testes).
; O script start.sh usa essa variável para iniciar o Odoo isolado.

; Addons: customizados primeiro, depois os nativos do Odoo
addons_path = /mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons

; Porta HTTP
http_port = 8069

; OBRIGATÓRIO quando rodando atrás de proxy reverso (Traefik do Dokploy)
proxy_mode = True

; Sem dados de demonstração em produção
without_demo = all

; Log para stdout (aparece no 'docker logs' do Dokploy)
logfile = False
log_level = info

; Workers (descomente e ajuste conforme a RAM da VPS)
; Regra geral: workers = (núcleos * 2) + 1
; workers = 3
; max_cron_threads = 1

; Desativa o gerenciador de bancos (/web/database/manager):
; as rotas de create/duplicate/restore/backup/delete respondem AccessDenied
; e a página fica apenas com o aviso "disabled by the administrator".
; O login continua direto no banco do container (start.sh usa --database $DB_NAME).
list_db = False
