<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Esconder o widget de Créditos Pendentes (outstanding credits) da fatura -->
    <!-- O pagamento deve ser feito apenas pelo botão "Registrar Pagamento" -->
    <record id="view_move_form_hide_outstanding" model="ir.ui.view">
        <field name="name">account.move.form.hide.outstanding</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('oe_subtotal_footer')][@invisible=&quot;state != 'posted' or not invoice_has_outstanding&quot;]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>