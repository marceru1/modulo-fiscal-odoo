<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Formulário da NF-e modelo 55 (ticket 04).

        Sem botões de Validar/Emitir nesta etapa: eles só entram nos tickets
        08/09 ("nenhum botão sem função"). Aqui o operador confere cabeçalho
        e itens da transferência.
    -->
    <record id="view_nfe_documento_form" model="ir.ui.view">
        <field name="name">nfe.documento.form</field>
        <field name="model">nfe.documento</field>
        <field name="arch" type="xml">
            <form string="NF-e" create="false">
                <header>
                    <button name="nfe_validar" type="object" string="Validar NF-e"
                            class="btn-primary"
                            groups="meu_modulo_fiscal.group_nfe_usuario"
                            invisible="state != 'rascunho'"/>
                    <field name="state" widget="statusbar" statusbar_visible="rascunho,validada"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="alert alert-warning" role="status" invisible="not pendencias">
                        <strong>Pendências da conferência local</strong>
                        <field name="pendencias" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="status">
                        A conferência é local e <strong>não é autorização fiscal</strong>:
                        ela apenas verifica os dados antes de preparar o envio.
                    </div>
                    <group>
                        <group string="Origem">
                            <field name="picking_id"/>
                            <field name="data_movimentacao"/>
                            <field name="data_preparacao"/>
                        </group>
                        <group string="Empresas">
                            <field name="company_id"/>
                            <field name="filial_id"/>
                            <field name="pode_editar_fiscal" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Produtos" name="produtos">
                            <field name="linha_ids">
                                <list string="Produtos transferidos">
                                    <field name="pode_editar_fiscal" invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="descricao" optional="show" readonly="not pode_editar_fiscal"/>
                                    <field name="uom_id"/>
                                    <field name="quantidade"/>
                                    <field name="custo_unitario"/>
                                    <field name="total_linha" sum="Total dos produtos"/>
                                    <field name="ncm" optional="show" readonly="not pode_editar_fiscal"/>
                                    <field name="cfop" optional="show" readonly="not pode_editar_fiscal"/>
                                    <field name="origem" optional="show" readonly="not pode_editar_fiscal"/>
                                    <field name="icms_cst_csosn" optional="show" readonly="not pode_editar_fiscal"/>
                                    <field name="pis_cst" optional="hide" readonly="not pode_editar_fiscal"/>
                                    <field name="cofins_cst" optional="hide" readonly="not pode_editar_fiscal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_produtos"/>
                            </group>
                        </page>
                        <page string="Dados complementares" name="complementares">
                            <group>
                                <group string="Transporte">
                                    <field name="modalidade_frete"/>
                                    <field name="transportadora" placeholder="Nome da transportadora (opcional)"/>
                                </group>
                                <group string="Pagamento">
                                    <field name="forma_pagamento"/>
                                    <field name="valor_pagamento"/>
                                </group>
                            </group>
                            <separator string="Informações adicionais"/>
                            <field name="informacoes_adicionais" nolabel="1"
                                   placeholder="Observações que vão para a NF-e"/>
                        </page>
                        <page string="Dados fiscais" name="fiscais">
                            <div class="alert alert-info" role="status">
                                Dados copiados da configuração fiscal na preparação da nota.
                                Alterações posteriores na configuração NÃO atualizam esta nota —
                                a correção no rascunho é explícita e exige nova validação.
                                Ajustes só pelo Responsável fiscal.
                            </div>
                            <group string="Emitente">
                                <group>
                                    <field name="emitente_cnpj" readonly="not pode_editar_fiscal"/>
                                    <field name="emitente_ie" readonly="not pode_editar_fiscal"/>
                                    <field name="emitente_crt" readonly="not pode_editar_fiscal"/>
                                    <field name="emitente_ibge_municipio" readonly="not pode_editar_fiscal"/>
                                    <field name="ambiente" readonly="not pode_editar_fiscal"/>
                                    <field name="serie" readonly="not pode_editar_fiscal"/>
                                </group>
                                <group>
                                    <field name="emitente_logradouro" readonly="not pode_editar_fiscal"/>
                                    <field name="emitente_numero" readonly="not pode_editar_fiscal"/>
                                    <field name="emitente_complemento" readonly="not pode_editar_fiscal"/>
                                    <field name="emitente_bairro" readonly="not pode_editar_fiscal"/>
                                    <field name="emitente_municipio" readonly="not pode_editar_fiscal"/>
                                    <field name="emitente_uf" readonly="not pode_editar_fiscal"/>
                                    <field name="emitente_cep" readonly="not pode_editar_fiscal"/>
                                </group>
                            </group>
                            <group string="Destinatária">
                                <group>
                                    <field name="destinataria_cnpj" readonly="not pode_editar_fiscal"/>
                                    <field name="destinataria_ie" readonly="not pode_editar_fiscal"/>
                                    <field name="destinataria_crt" readonly="not pode_editar_fiscal"/>
                                    <field name="destinataria_ibge_municipio" readonly="not pode_editar_fiscal"/>
                                </group>
                                <group>
                                    <field name="destinataria_logradouro" readonly="not pode_editar_fiscal"/>
                                    <field name="destinataria_numero" readonly="not pode_editar_fiscal"/>
                                    <field name="destinataria_complemento" readonly="not pode_editar_fiscal"/>
                                    <field name="destinataria_bairro" readonly="not pode_editar_fiscal"/>
                                    <field name="destinataria_municipio" readonly="not pode_editar_fiscal"/>
                                    <field name="destinataria_uf" readonly="not pode_editar_fiscal"/>
                                    <field name="destinataria_cep" readonly="not pode_editar_fiscal"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Lista: sem criação avulsa nesta versão (a nota nasce da transferência). -->
    <record id="view_nfe_documento_list" model="ir.ui.view">
        <field name="name">nfe.documento.list</field>
        <field name="model">nfe.documento</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="data_movimentacao"/>
                <field name="company_id"/>
                <field name="filial_id"/>
                <field name="total_produtos" sum="Total dos produtos"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'rascunho'"
                       decoration-success="state == 'validada'"/>
            </list>
        </field>
    </record>

    <record id="view_nfe_documento_search" model="ir.ui.view">
        <field name="name">nfe.documento.search</field>
        <field name="model">nfe.documento</field>
        <field name="arch" type="xml">
            <search string="Notas fiscais">
                <field name="name"/>
                <field name="picking_id" filter_domain="[('picking_id.name', 'ilike', self)]"/>
                <field name="company_id"/>
                <field name="filial_id"/>
                <filter name="periodo" date="data_movimentacao" string="Período"/>
                <separator/>
                <filter name="situacao_rascunho" string="Rascunho" domain="[('state', '=', 'rascunho')]"/>
                <filter name="situacao_validada" string="Validada" domain="[('state', '=', 'validada')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="agrupar_empresa" string="Empresa" context="{'group_by': 'company_id'}"/>
                    <filter name="agrupar_filial" string="Filial" context="{'group_by': 'filial_id'}"/>
                    <filter name="agrupar_situacao" string="Situação" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nfe_documento" model="ir.actions.act_window">
        <field name="name">Notas fiscais</field>
        <field name="res_model">nfe.documento</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nenhuma NF-e preparada</p>
            <p>A nota nasce do botão <strong>Emitir NF-e</strong> de uma transferência concluída para a filial.</p>
        </field>
    </record>
</odoo>
