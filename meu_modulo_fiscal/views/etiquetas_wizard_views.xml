<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- View PRÓPRIA (primary), não herança da form do core.

             Os wizards de etiqueta abertos pelo Estoque/MRP usam
             `product.product_label_layout_form` e não devem ganhar os campos da
             loja. `priority` 99 mantém a view do core como form padrão do
             modelo para quem abrir o wizard sem fixar view. -->
        <record id="product_label_layout_etiquetas_form" model="ir.ui.view">
            <field name="name">product.label.layout.form.etiquetas</field>
            <field name="model">product.label.layout</field>
            <field name="mode">primary</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="x_label_format" widget="radio" required="1"/>
                    </group>
                    <!-- Quantidade POR PRODUTO — uma linha por produto. -->
                    <field name="x_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                    <footer>
                        <button name="process" string="Imprimir" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_etiquetas_wizard" model="ir.actions.act_window">
            <field name="name">Imprimir Etiquetas</field>
            <field name="res_model">product.label.layout</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="product_label_layout_etiquetas_form"/>
            <field name="target">new</field>
        </record>

        <!-- Tela de seleção: o operador marca os produtos e usa o botão da toolbar. -->
        <record id="action_etiquetas_produtos" model="ir.actions.act_window">
            <field name="name">Etiquetas</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Botão "Imprimir Etiquetas" na toolbar da lista de produtos. Cria o
             wizard já com uma linha por produto selecionado (quantidade 1). -->
        <record id="action_etiquetas_from_products" model="ir.actions.server">
            <field name="name">Imprimir Etiquetas</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
wizard = env['product.label.layout'].create({
    'x_label_format': 'bijuteria',
    'x_line_ids': [(0, 0, {'product_id': rec.id, 'quantity': 1}) for rec in records],
})
action = env['ir.actions.act_window'].browse(env.ref('meu_modulo_fiscal.action_etiquetas_wizard').id).read()[0]
action['res_id'] = wizard.id
action
            </field>
        </record>

    </data>
</odoo>
