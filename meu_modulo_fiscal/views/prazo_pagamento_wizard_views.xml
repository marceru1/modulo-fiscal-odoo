<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard 'Registrar Pagamento' da conta a prazo do contato
         (DEC-A/DEC-B da spec prazo-por-contato). O contato é o campo de
         entrada obrigatório: o domain de fatura_id e o núcleo de recebimento
         leem dele. -->
    <record id="view_prazo_pagamento_wizard_form" model="ir.ui.view">
        <field name="name">x.prazo.pagamento.wizard.form</field>
        <field name="model">x.prazo.pagamento.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar Pagamento">
                <group>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="fatura_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="valor"/>
                    <field name="journal_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_confirmar" string="Confirmar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_prazo_pagamento_wizard" model="ir.actions.act_window">
        <field name="name">Registrar Pagamento</field>
        <field name="res_model">x.prazo.pagamento.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_prazo_pagamento_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
