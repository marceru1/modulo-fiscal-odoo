<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Menu Faturamento → NF-e (tickets 02 e 06).
        O menu pai "Faturamento" é do módulo account (account.menu_finance),
        já instalado via point_of_sale. Nenhuma dependência nova no manifest.
    -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <!--
            O menu Faturamento só era visível para quem tem grupo de
            contabilidade. Acrescentar o grupo NF-e (m2m: só ADICIONA) mostra
            o Faturamento ao usuário NF-e SEM dar nenhuma permissão sobre
            faturas: a visibilidade dos menus de ação continua barrada pela
            ACL de account.move (ir_ui_menu.py:110-128 — "access.check(model,
            'read')"), e as faturas do crediário exigem grupo de contabilidade
            (account/security/ir.model.access.csv:40-42).
        -->
        <field name="groups_id" eval="[(4, ref('group_nfe_usuario'))]"/>
    </record>

    <menuitem id="menu_nfe_root"
              name="NF-e"
              parent="account.menu_finance"
              sequence="95"/>

    <menuitem id="menu_nfe_notas"
              name="Notas fiscais"
              parent="menu_nfe_root"
              action="action_nfe_documento"
              groups="meu_modulo_fiscal.group_nfe_usuario"
              sequence="10"/>

    <menuitem id="menu_nfe_config"
              name="Configurações fiscais"
              parent="menu_nfe_root"
              action="action_nfe_config"
              groups="meu_modulo_fiscal.group_nfe_responsavel_fiscal"
              sequence="20"/>
</odoo>
