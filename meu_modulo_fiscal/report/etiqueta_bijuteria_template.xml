<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Etiqueta Bijuteria — 34,8 x 20 mm (paperformat_etiqueta_bijuteria).
             Conteúdo: nome, referência (se houver), Code128 do EAN, dígitos do
             EAN e preço. Sem rodapé (paridade com o layout A do BarTender).

             Bobina de UMA via: UMA etiqueta por página do PDF. Mesma arquitetura
             da confeccao (que multiplica a quantidade certa): achata
             {produto: [(barcode, qtd)]} numa fila e monta UMA .x_linha_etiquetas
             (== uma página) por etiqueta, com per_page=1. A quebra de página vem
             da regra `.x_linha_etiquetas + .x_linha_etiquetas { page-break-before
             }` do etiqueta_styles — célula de tabela não quebra página no
             wkhtmltopdf; a quebra tem que ser entre blocos de LINHA (foi este o
             bug da quantidade ignorada na bijuteria). -->
        <template id="report_etiqueta_bijuteria">
            <t t-set="full_width" t-value="True"/>
            <t t-set="per_page" t-value="1"/>
            <t t-set="pages" t-value="(total_quantity + per_page - 1) // per_page"/>
            <t t-call="web.html_container">
                <t t-call="meu_modulo_fiscal.etiqueta_styles_bijuteria"/>

                <t t-set="fila" t-value="[]"/>
                <t t-foreach="quantity.items()" t-as="produto_e_lista">
                    <t t-foreach="produto_e_lista[1]" t-as="barcode_e_qtd">
                        <t t-foreach="range(barcode_e_qtd[1])" t-as="n">
                            <t t-set="fila" t-value="fila + [(produto_e_lista[0], barcode_e_qtd[0])]"/>
                        </t>
                    </t>
                </t>

                <t t-foreach="range(pages)" t-as="pagina">
                    <div class="x_linha_etiquetas">
                        <t t-foreach="range(per_page)" t-as="coluna">
                            <t t-set="idx" t-value="pagina * per_page + coluna"/>
                            <t t-if="idx &lt; len(fila)">
                                <t t-set="product" t-value="fila[idx][0]"/>
                                <t t-set="barcode" t-value="fila[idx][1]"/>
                                <div class="x_etiqueta x_etiqueta_bijuteria">
                                    <div class="x_eti_nome" t-out="product.name.upper()"/>
                                    <div class="x_eti_ref" t-if="product.default_code" t-out="product.default_code"/>
                                    <!-- barcode do t-set (fila), não product.barcode: há
                                         produto sem código, e aí o bloco de barras não
                                         sai. width/height intrínsecos (930x180) mantêm a
                                         proporção do img_style (31 x 6 mm). -->
                                    <div class="x_eti_barcode" t-if="barcode">
                                        <t t-out="barcode" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'quiet': 0, 'width': 930, 'height': 180, 'img_style': 'width:31mm;height:6mm'}"/>
                                    </div>
                                    <div class="x_eti_digitos" t-if="barcode" t-out="barcode"/>
                                    <div class="x_eti_preco">
                                        <!-- Ver nota no template da Confecção: widget 'monetary'
                                             emite `R$\xa0<span>` e o wkhtmltopdf corrompe o
                                             NBSP — sai "R$Â 40,00". Símbolo cru + widget 'float'
                                             sai como texto puro e seguro. -->
                                        <t t-out="product.currency_id.symbol"/>
                                        <t t-out="product.lst_price" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>