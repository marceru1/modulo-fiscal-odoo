<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Etiqueta Confecção — 35 x 60 mm (paperformat_etiqueta_confeccao).
             Mesmo conteúdo da Bijuteria com preço maior e rodapé Instagram
             (paridade com o layout B do BarTender). -->
        <template id="report_etiqueta_confeccao">
            <t t-set="full_width" t-value="True"/>
            <t t-call="web.html_container">
                <t t-call="meu_modulo_fiscal.etiqueta_styles"/>

                <t t-foreach="quantity.items()" t-as="barcode_and_qty_by_product">
                    <t t-set="product" t-value="barcode_and_qty_by_product[0]"/>
                    <t t-foreach="barcode_and_qty_by_product[1]" t-as="barcode_and_qty">
                        <t t-set="barcode" t-value="barcode_and_qty[0]"/>
                        <t t-foreach="range(barcode_and_qty[1])" t-as="qty">
                            <div class="x_etiqueta x_etiqueta_confeccao">
                                <div class="x_eti_nome" t-out="product.name.upper()"/>
                                <div class="x_eti_ref" t-if="product.default_code" t-out="product.default_code"/>
                                <div class="x_eti_barcode" t-if="barcode">
                                    <t t-out="product.barcode" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'quiet': 0, 'width': 930, 'height': 420, 'img_style': 'width:31mm;height:14mm'}"/>
                                </div>
                                <div class="x_eti_digitos" t-if="barcode" t-out="barcode"/>
                                <div class="x_eti_preco">
                                    <!-- Ver nota no template da Bijuteria: 'monetary' + wkhtmltopdf
                                         corrompe o NBSP e sai "R$Â 40,00". -->
                                    <t t-out="product.currency_id.symbol"/>
                                    <t t-out="product.lst_price" t-options="{'widget': 'float', 'precision': 2}"/>
                                </div>
                                <div class="x_eti_rodape">
                                    <!-- SVG inline no lugar de <i class="fa fa-instagram"/>:
                                         webfont do Font Awesome não é confiável no
                                         wkhtmltopdf (risco de tofu). O glifo é o mesmo. -->
                                    <svg width="3mm" height="3mm" viewBox="0 0 24 24"
                                         fill="none" stroke="#000" stroke-width="2"
                                         style="vertical-align:-0.5mm">
                                        <rect x="2" y="2" width="20" height="20" rx="5"/>
                                        <circle cx="12" cy="12" r="4.5"/>
                                        <circle cx="17.5" cy="6.5" r="1.2" fill="#000" stroke="none"/>
                                    </svg>
                                    @lojas20mais_itacoatiara
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
