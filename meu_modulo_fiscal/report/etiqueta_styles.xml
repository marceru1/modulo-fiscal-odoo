<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Estilos compartilhados das etiquetas.

             Fica num template próprio (chamado pelos dois relatórios) em vez de
             num asset em `web.report_assets_common`: assim o reset de `body`
             vale só para ESTE documento renderizado, sem vazar para os demais
             relatórios do Odoo que compartilham o mesmo bundle de CSS. -->
        <template id="etiqueta_styles">
            <style>
                /* O relatório do core usa `body.container`/`container-fluid`, cujo
                   padding (~3mm de cada lado) deslocaria a etiqueta dentro de uma
                   página de 34,8mm. Reset local do documento.

                   Sem `overflow: hidden` aqui: no wkhtmltopdf o documento é
                   renderizado como uma página longa e recortado, e esconder o
                   overflow do root cortaria as páginas seguintes. */
                html, body, #wrapwrap, #wrapwrap > main {
                    margin: 0 !important;
                    padding: 0 !important;
                    background: #fff;
                }

                /* A página tem a largura do ROLO (105mm = 3 colunas de 35mm).
                   width:100% não serve aqui: o body do relatório é `container`
                   (largura fixa do Bootstrap) e cortaria a 3ª coluna. */
                html, body, #wrapwrap, #wrapwrap > main, .x_linha_etiquetas {
                    width: 105mm !important;
                }

                /* Uma LINHA de etiquetas por página, com as colunas lado a lado.
                   A quebra é entre LINHAS (não entre etiquetas): assim a linha
                   inteira sai numa passada e o `2 cópias` sai lado a lado em vez
                   de descer o papel. */
                .x_linha_etiquetas {
                    display: table;      /* tabela: as colunas ficam na mesma linha */
                    table-layout: fixed;
                    page-break-inside: avoid;
                }

                .x_linha_etiquetas + .x_linha_etiquetas {
                    page-break-before: always;
                }

                .x_etiqueta {
                    display: table-cell;
                    box-sizing: border-box;
                    overflow: hidden;
                    position: relative;
                    color: #000;
                    background: #fff;
                    font-family: Arial, Helvetica, sans-serif;
                    text-align: center;
                    /* evita o espaço fantasma entre inline-blocks */
                    vertical-align: top;
                }

                .x_etiqueta .x_eti_nome {
                    font-weight: bold;
                    text-transform: uppercase;
                    line-height: 1.05;
                    overflow: hidden;
                }

                .x_etiqueta .x_eti_ref {
                    font-size: 0.85em;
                    line-height: 1;
                    overflow: hidden;
                }

                .x_etiqueta .x_eti_barcode img {
                    display: block;
                    margin: 0 auto;
                }

                .x_etiqueta .x_eti_digitos {
                    font-size: 0.8em;
                    line-height: 1;
                    letter-spacing: 0.4px;
                    white-space: nowrap;
                }

                .x_etiqueta .x_eti_preco {
                    text-align: right;
                    font-weight: bold;
                    line-height: 1.1;
                    white-space: nowrap;
                }

                .x_etiqueta .x_eti_rodape {
                    position: absolute;
                    left: 0;
                    right: 0;
                    bottom: 1mm;
                    text-align: center;
                    font-size: 0.85em;
                    line-height: 1;
                    white-space: nowrap;
                }

                /* Bijuteria — 35 x 20 mm (bobina real 34,8 mm; o papel do
                   paperformat é Integer e vai a 35 mm, então o conteúdo usa
                   34.8mm e sobra 0,1mm de sangria de cada lado). */
                .x_etiqueta_bijuteria {
                    width: 34.8mm;
                    height: 20mm;
                    font-size: 7pt;
                    line-height: 1.05;
                    padding: 0.8mm 1.2mm 0.5mm;
                }

                .x_etiqueta_bijuteria .x_eti_barcode {
                    padding-top: 0.8mm;
                }

                .x_etiqueta_bijuteria .x_eti_preco {
                    font-size: 1.15em;
                    margin-top: 1.2mm;
                }

                /* Confecção — 35 x 60 mm.
                   ATENÇÃO: a faixa superior (~19 mm) da etiqueta é PRÉ-IMPRESSA
                   com o logotipo da loja e não pode receber impressão nenhuma
                   (zona de exclusão térmica). Por isso o conteúdo só começa a
                   partir de Y = 21,5 mm do topo — a 2,5 mm abaixo da logo. */
                .x_etiqueta_confeccao {
                    width: 35mm;
                    height: 60mm;
                    font-size: 8pt;
                    line-height: 1.15;
                    /* padding-top aqui (e não margin no 1º filho) para o
                       margin-top não colapsar com o container e puxar tudo
                       pra cima. 21,5mm = faixa pré-impressa (19mm) + resguardo.
                       laterais 2,5mm: largura útil ~30mm (o cabeçote da L42
                       não imprime nas bordas). */
                    padding: 21.5mm 2.5mm 0;
                }

                .x_etiqueta_confeccao .x_eti_nome {
                    font-size: 1.15em;
                }

                .x_etiqueta_confeccao .x_eti_barcode {
                    padding-top: 4.5mm;
                }

                .x_etiqueta_confeccao .x_eti_digitos {
                    font-size: 0.9em;
                    margin-top: 0.5mm;
                }

                .x_etiqueta_confeccao .x_eti_preco {
                    font-size: 1.7em;
                    margin-top: 3.5mm;
                }

                /* Rodapé: a spec pede a faixa 52–55 mm, ou seja 5 mm de
                   sangria inferior livre. */
                .x_etiqueta_confeccao .x_eti_rodape {
                    bottom: 5mm;
                }
            </style>
        </template>

    </data>
</odoo>
