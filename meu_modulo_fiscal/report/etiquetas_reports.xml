<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Paperformats com as dimensões exatas das etiquetas da Elgin L42Pro.
             `format='custom'` + `page_width`/`page_height` em mm é o que o
             ir.actions.report converte nas flags de tamanho de página do
             wkhtmltopdf (ir_actions_report.py:316). -->
        <record id="paperformat_etiqueta_bijuteria" model="report.paperformat">
            <field name="name">Etiqueta Bijuteria (34,8 x 20 mm)</field>
            <field name="format">custom</field>
            <field name="page_height">20</field>
            <field name="page_width">34.8</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="disable_shrinking" eval="True"/>
            <field name="dpi">96</field>
        </record>

        <record id="paperformat_etiqueta_confeccao" model="report.paperformat">
            <field name="name">Etiqueta Confecção (35 x 60 mm)</field>
            <field name="format">custom</field>
            <field name="page_height">60</field>
            <field name="page_width">35</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="disable_shrinking" eval="True"/>
            <field name="dpi">96</field>
        </record>

        <!-- Os xml_id abaixo são os referenciados por
             product.label.layout._X_LABEL_REPORTS — manter em sincronia. -->
        <record id="action_report_etiqueta_bijuteria" model="ir.actions.report">
            <field name="name">Etiqueta de Produto (Bijuteria)</field>
            <field name="model">product.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">meu_modulo_fiscal.report_etiqueta_bijuteria</field>
            <field name="report_file">meu_modulo_fiscal.report_etiqueta_bijuteria</field>
            <field name="paperformat_id" ref="paperformat_etiqueta_bijuteria"/>
        </record>

        <record id="action_report_etiqueta_confeccao" model="ir.actions.report">
            <field name="name">Etiqueta de Produto (Confecção)</field>
            <field name="model">product.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">meu_modulo_fiscal.report_etiqueta_confeccao</field>
            <field name="report_file">meu_modulo_fiscal.report_etiqueta_confeccao</field>
            <field name="paperformat_id" ref="paperformat_etiqueta_confeccao"/>
        </record>

    </data>
</odoo>
