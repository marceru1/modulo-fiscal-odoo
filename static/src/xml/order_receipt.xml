<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="meu_modulo.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        
        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="replace"/>
        
        <!-- ✅ REMOVE AS LINHAS DE PAGAMENTO PADRÃO -->
        <xpath expr="//div[hasclass('paymentlines')]" position="replace"/>
        
        <!-- ✅ REMOVE OS FOOTERS -->
        <xpath expr="//div[hasclass('before-footer')]" position="replace"/>
        <xpath expr="//div[hasclass('after-footer')]" position="replace"/>
        <xpath expr="//div[hasclass('pos-receipt-order-data')]" position="replace"/>

        <!-- ============================================ -->
        <!-- CABEÇALHO DO ESTABELECIMENTO -->
        <!-- ============================================ -->
        <xpath expr="//ReceiptHeader" position="replace">
            <div class="danfe-header">
                <div class="emitente-nome">MINHA LOJA TESTE LTDA</div>
                <div class="emitente-dados">
                    CNPJ: 12.345.678/0001-99
                </div>
                <div class="emitente-dados">
                    IE: 123.456.789.111
                </div>
                <div class="emitente-endereco">
                    Av. Paulista, 1000 - Bela Vista<br/>
                    São Paulo - SP - CEP 01310-100
                </div>
            </div>

            <div class="danfe-separador"></div>

            <div class="danfe-tipo">
                DANFE NFC-e - Documento Auxiliar da Nota<br/>
                Fiscal de Consumidor Eletrônica
            </div>

            <div class="danfe-separador"></div>
        </xpath>

        <!-- ============================================ -->
        <!-- ITENS DA NOTA -->
        <!-- ============================================ -->
        <xpath expr="//OrderWidget" position="replace">
            
            <div class="danfe-items">
                
                <!-- Cabeçalho dos itens -->
                <div class="items-header">
                    <span class="h-codigo">CÓD</span>
                    <span class="h-descricao">DESCRIÇÃO</span>
                    <span class="h-qtd">QTD</span>
                    <span class="h-un">UN</span>
                    <span class="h-vlr">VL.UN(R$)</span>
                    <span class="h-total">VL.TOT(R$)</span>
                </div>

                <div class="danfe-separador"></div>

                <!-- Loop dos produtos -->
                <t t-foreach="props.data.danfe_items" t-as="item" t-key="item.index">
                    
                    <!-- Linha 1: Código e Descrição -->
                    <div class="item-linha1">
                        <span class="item-num"><t t-esc="item.index"/></span>
                        <span class="item-codigo"><t t-esc="item.code"/></span>
                        <span class="item-descricao"><t t-esc="item.description"/></span>
                    </div>

                    <!-- Linha 2: Quantidade, Unidade, Valores -->
                    <div class="item-linha2">
                        <span class="item-qtd"><t t-esc="item.qntd"/></span>
                        <span class="item-un">UN</span>
                        <span class="item-vlr-un">x <t t-esc="props.formatCurrency(item.vlr_unit)"/></span>
                        
                        <!-- Mostra desconto se houver -->
                        <t t-if="item.desc > 0">
                            <span class="item-desc">
                                Desc: <t t-esc="props.formatCurrency(item.desc)"/>
                            </span>
                        </t>
                        
                        <span class="item-total"><t t-esc="props.formatCurrency(item.vlr_total)"/></span>
                    </div>

                </t>

            </div>

            <div class="danfe-separador"></div>

        </xpath>

        <!-- ============================================ -->
        <!-- TOTAIS E PAGAMENTO -->
        <!-- ============================================ -->
        <xpath expr="//div[hasclass('pos-receipt-taxes')]" position="replace">
    
            <div class="totais-section">
                
                <div class="total-linha">
                    <span class="total-label">QTD. TOTAL DE ITENS</span>
                    <span class="total-valor"><t t-esc="props.data.danfe_totais.qtd_itens"/></span>
                </div>

                <t t-if="props.data.danfe_totais.desconto_total > 0">
                    <div class="total-linha">
                        <span class="total-label">DESCONTO</span>
                        <span class="total-valor">
                            <t t-esc="props.formatCurrency(props.data.danfe_totais.desconto_total)"/>
                        </span>
                    </div>
                </t>

                <div class="total-linha total-destaque">
                    <span class="total-label">VALOR TOTAL R$</span>
                    <span class="total-valor">
                        <t t-esc="props.formatCurrency(props.data.danfe_totais.valor_total)"/>
                    </span>
                </div>

            </div>

            <div class="danfe-separador"></div>

            <!-- Formas de Pagamento -->
            <div class="pagamento-section">
                <div class="pagamento-titulo">FORMA DE PAGAMENTO</div>
                
                <t t-foreach="props.data.danfe_totais.metodos" t-as="pgto" t-key="pgto.metodo_nome">
                    <div class="pagamento-linha">
                        <span class="pagamento-metodo"><t t-esc="pgto.metodo_nome"/></span>
                        <span class="pagamento-valor">
                            <t t-esc="props.formatCurrency(pgto.metodo_valor)"/>
                        </span>
                    </div>
                </t>
            </div>

            <div class="danfe-separador"></div>

            <!-- ============================================ -->
            <!-- DADOS FISCAIS DA NFCe -->
            <!-- ============================================ -->
            <div class="fiscal-section">
                
                <!-- NFCe Autorizada -->
                <t t-if="props.data.x_fiscal.status === 'autorizado'">
                    
                    <div class="fiscal-numero">
                        <strong>NFC-e Nº <t t-esc="props.data.x_fiscal.numero"/></strong>
                        Série <t t-esc="props.data.x_fiscal.serie"/>
                    </div>

                    <div class="fiscal-data-emissao">
                        Emissão: <t t-esc="props.data.date"/>
                    </div>

                    <div class="danfe-separador-fino"></div>

                    <div class="fiscal-consulta">
                        Consulte pela Chave de Acesso em<br/>
                        <span class="fiscal-url"><t t-esc="props.data.x_fiscal.url_consulta"/></span>
                    </div>

                    <div class="fiscal-chave-titulo">CHAVE DE ACESSO</div>
                    <div class="fiscal-chave-valor">
                        <t t-esc="props.data.x_fiscal.chave"/>
                    </div>

                    <div class="danfe-separador-fino"></div>

                    <!-- Consumidor -->
                    <div class="fiscal-consumidor">
                        <t t-if="props.data.x_cpf_nota">
                            CONSUMIDOR: <t t-esc="props.data.x_cpf_nota"/>
                        </t>
                        <t t-else="">
                            CONSUMIDOR NÃO IDENTIFICADO
                        </t>
                    </div>

                    <div class="danfe-separador-fino"></div>

                    <!-- Protocolo ou Contingência -->
                    <t t-if="props.data.x_fiscal.offline">
                        <div class="fiscal-contingencia">
                            ⚠ EMITIDA EM CONTINGÊNCIA OFF-LINE<br/>
                            DANFE em Contingência, impresso em decorrência<br/>
                            de problemas técnicos
                        </div>
                    </t>
                    <t t-else="">
                        <div class="fiscal-protocolo">
                            Protocolo de Autorização:<br/>
                            <strong><t t-esc="props.data.x_fiscal.protocolo"/></strong><br/>
                            <t t-esc="props.data.date"/>
                        </div>
                    </t>

                    <div class="danfe-separador-fino"></div>

                    <!-- QR CODE -->
                    <div class="fiscal-qrcode">
                        <img t-att-src="props.data.x_fiscal.qrcode_url" 
                             alt="QR Code NFCe"
                             class="qrcode-img"/>
                    </div>

                    <div class="fiscal-rodape">
                        Consulte o QR Code pelo aplicativo<br/>
                        "De olho na nota", disponível na AppStore<br/>
                        (Apple) e PlayStore (Android)
                    </div>

                    <div class="danfe-separador-fino"></div>

                    <!-- Tributos -->
                    <div class="fiscal-tributos">
                        Tributos Totais Incidentes (Lei Federal 12.741/2012): R$ 0,00
                    </div>

                </t>

                <!-- NFCe com Erro -->
                <t t-elif="props.data.x_fiscal.status === 'erro'">
                    <div class="fiscal-erro">
                        <strong>❌ NFC-e REJEITADA PELA SEFAZ</strong><br/><br/>
                        <t t-esc="props.data.x_fiscal.mensagem"/>
                    </div>
                </t>

                <!-- Aguardando processamento -->
                <t t-else="">
                    <div class="fiscal-aguardando">
                        ⏳ Aguardando processamento fiscal...<br/>
                        Reimprima em alguns instantes
                    </div>
                </t>

            </div>

        </xpath>


    </t>

</templates>